{
  "$schema": "wireframe/v1",
  "id": "db.lock.refusal.missing_reason",
  "scenario": {
    "db_key": "orders:ORD-10"
  },
  "target": {
    "$slot": "db_key",
    "$from": "scenario.db_key",
    "$example": "orders:ORD-10"
  },
  "command": {
    "$interpolate": "capcli db lock {{db_key}} --ttl 300s",
    "$bindings": {
      "db_key": "scenario.db_key"
    },
    "$example": "capcli db lock orders:ORD-10 --ttl 300s"
  },
  "elapsed_ms": {
    "$slot": "elapsed_ms",
    "$from": "live.elapsed_ms",
    "$type": "integer",
    "$example": 21
  },
  "context": {
    "env": "dev",
    "tier": "tier_1",
    "trust": "draft"
  },
  "archetype": "diagnostic",
  "component": {
    "rule": "missing_param.lock.reason_required",
    "domain": "missing_param",
    "culprit": {
      "$slot": "culprit",
      "$from": "live.culprit",
      "$example": "--reason is required for locking; no causal justification supplied."
    },
    "remedy": "re-run with --reason \"why this lease is needed\"",
    "target": {
      "$slot": "db_key_2",
      "$from": "scenario.db_key",
      "$example": "orders:ORD-10"
    },
    "ttl": {
      "$slot": "ttl",
      "$from": "live.ttl",
      "$example": "300s"
    },
    "reason": {
      "$slot": "reason",
      "$from": "live.reason",
      "$example": "(absent)"
    },
    "lines": [
      {
        "$slot": "lines_0",
        "$from": "live.lines[0]",
        "$example": "--reason is required for locking; unjustified leases are refused."
      }
    ]
  }
}
