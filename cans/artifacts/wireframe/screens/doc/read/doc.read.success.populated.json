{
  "$schema": "wireframe/v1",
  "id": "doc.read.success.populated",
  "scenario": {
    "doc_urp": "doc://refund-policy"
  },
  "target": {
    "$slot": "doc_urp",
    "$from": "scenario.doc_urp",
    "$example": "doc://refund-policy"
  },
  "command": {
    "$interpolate": "capcli doc read {{doc_urp}} --max-tokens 500",
    "$bindings": {
      "doc_urp": "scenario.doc_urp"
    },
    "$example": "capcli doc read doc://refund-policy --max-tokens 500"
  },
  "elapsed_ms": {
    "$slot": "elapsed_ms",
    "$from": "live.elapsed_ms",
    "$type": "integer",
    "$example": 2208
  },
  "context": {
    "env": "dev",
    "tier": "tier_1",
    "trust": "pinned",
    "data_shape": {
      "$slot": "data_shape",
      "$from": "context.data_shape",
      "$example": "populated"
    }
  },
  "archetype": "document",
  "component": {
    "header_badge": {
      "$interpolate": "{{doc_urp}} (full)",
      "$bindings": {
        "doc_urp": "scenario.doc_urp"
      },
      "$example": "doc://refund-policy (full)"
    },
    "meta": {
      "document": {
        "$slot": "doc_urp_2",
        "$from": "scenario.doc_urp",
        "$example": "doc://refund-policy"
      },
      "tokens": {
        "$slot": "tokens",
        "$from": "live.meta.tokens",
        "$example": "312 (cap: 500)"
      },
      "has_more": {
        "$slot": "has_more",
        "$from": "live.meta.has_more",
        "$type": "boolean",
        "$example": false
      }
    },
    "fields": {
      "trust": {
        "$slot": "trust",
        "$from": "live.fields.trust",
        "$example": "pinned"
      },
      "source": {
        "$slot": "source",
        "$from": "live.fields.source",
        "$example": "git:docs/policies/refund-policy.md@2f6110a"
      },
      "sections": {
        "$slot": "sections",
        "$from": "live.fields.sections",
        "$example": "5"
      }
    },
    "body": [
      {
        "$slot": "body_0",
        "$from": "live.body[0]",
        "$example": "1. Scope"
      },
      {
        "$slot": "body_1",
        "$from": "live.body[1]",
        "$example": "Refund routing and approval rules for the storefront."
      },
      {
        "$slot": "body_2",
        "$from": "live.body[2]",
        "$example": "2. Refund windows"
      },
      {
        "$slot": "body_3",
        "$from": "live.body[3]",
        "$example": "Standard window is 30 days. Extended window is 120 days and requires"
      },
      {
        "$slot": "body_4",
        "$from": "live.body[4]",
        "$example": "supervisor approval."
      },
      {
        "$slot": "body_5",
        "$from": "live.body[5]",
        "$example": "3. Stripe integration notes"
      },
      {
        "$slot": "body_6",
        "$from": "live.body[6]",
        "$example": "Outbound refunds must include `charge_id` and idempotent client request UUID."
      },
      {
        "$slot": "body_7",
        "$from": "live.body[7]",
        "$example": "Never refund a charge older than 120 days via automated routines; delegate"
      },
      {
        "$slot": "body_8",
        "$from": "live.body[8]",
        "$example": "to human supervisor via `ctx.ping.ask`."
      },
      {
        "$slot": "body_9",
        "$from": "live.body[9]",
        "$example": "4. Currency handling"
      },
      {
        "$slot": "body_10",
        "$from": "live.body[10]",
        "$example": "Refunds settle in the original charge currency; no FX conversion on return."
      },
      {
        "$slot": "body_11",
        "$from": "live.body[11]",
        "$example": "5. Escalation paths"
      },
      {
        "$slot": "body_12",
        "$from": "live.body[12]",
        "$example": "Disputed or partial refunds escalate to a human supervisor via `ctx.ping.ask`."
      }
    ]
  },
  "affordances": [
    {
      "rel": {
        "$slot": "rel",
        "$from": "live.affordances[0].rel",
        "$example": "next"
      },
      "command": {
        "$interpolate": "capcli doc read {{doc_urp}} --max-tokens 100",
        "$bindings": {
          "doc_urp": "scenario.doc_urp"
        },
        "$example": "capcli doc read doc://refund-policy --max-tokens 100"
      },
      "intent": {
        "$slot": "intent",
        "$from": "live.affordances[0].intent",
        "$example": "Progressive disclosure: leading sections under token cap; typed keyset envelope"
      },
      "risk": {
        "$slot": "risk",
        "$from": "live.affordances[0].risk",
        "$example": "safe"
      }
    }
  ]
}
