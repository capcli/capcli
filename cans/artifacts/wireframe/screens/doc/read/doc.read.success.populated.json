          {
            "text": "────────────────────────────────────────────────────────────────────────────",
            "indent": 2
          },
          {
            "text": "1. Scope",
            "indent": 2
          },
          {
            "text": "Refund routing and approval rules for the storefront.",
            "indent": 2
          }
        ]
      },
      {
        "title": null,
        "items": [
          {
            "text": "2. Refund windows",
            "indent": 2
          },
          {
            "text": "Standard window is 30 days. Extended window is 120 days and requires",
            "indent": 2
          },
          {
            "text": "supervisor approval.",
            "indent": 2
          }
        ]
      },
      {
        "title": null,
        "items": [
          {
            "text": "3. Stripe integration notes",
            "indent": 2
          },
          {
            "text": "Outbound refunds must include `charge_id` and idempotent client request UUID.",
            "indent": 2
          },
          {
            "text": "Never refund a charge older than 120 days via automated routines; delegate",
            "indent": 2
          },
          {
            "text": "to human supervisor via `ctx.ping.ask`.",
            "indent": 2
          }
        ]
      },
      {
        "title": null,
        "items": [
          {
            "text": "4. Currency handling",
            "indent": 2
          },
          {
            "text": "Refunds settle in the original charge currency; no FX conversion on return.",
            "indent": 2
          }
        ]
      },
      {
        "title": null,
        "items": [
          {
            "text": "5. Escalation paths",
            "indent": 2
          },
          {
            "text": "Disputed or partial refunds escalate to a human supervisor via `ctx.ping.ask`.",
            "indent": 2
          }
        ]
      }
    ]
