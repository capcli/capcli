{
  "$schema": "wireframe/v1",
  "id": "rule.plan.success.planned",
  "scenario": {
    "intent": "rush shipping priority flag"
  },
  "archetype": "receipt",
  "audit_op": {
    "$slot": "audit_op",
    "$from": "live.audit_op",
    "$example": "op_7c48"
  },
  "command": {
    "$interpolate": "capcli rule plan --name \"add_order_priority\" -m \"{{intent}}\"",
    "$bindings": {
      "intent": "scenario.intent"
    },
    "$example": "capcli rule plan --name \"add_order_priority\" -m \"rush shipping priority flag\""
  },
  "elapsed_ms": {
    "$slot": "elapsed_ms",
    "$from": "live.elapsed_ms",
    "$type": "integer",
    "$example": 521
  },
  "component": {
    "groups": [
      {
        "fields": {
          "intent": {
            "$interpolate": "\"{{intent}}\"",
            "$bindings": {
              "intent": "scenario.intent"
            },
            "$example": "\"rush shipping priority flag\""
          },
          "migration": {
            "$slot": "migration",
            "$from": "live.groups[0].fields.migration",
            "$example": "add_order_priority"
          }
        }
      },
      {
        "lines": [
          {
            "$slot": "lines_0",
            "$from": "live.groups[1].lines[0]",
            "$example": "bundle:"
          },
          {
            "$slot": "lines_1",
            "$from": "live.groups[1].lines[1]",
            "$example": "plan.json"
          },
          {
            "$slot": "lines_2",
            "$from": "live.groups[1].lines[2]",
            "$example": "align stub"
          }
        ]
      }
    ],
    "title": null
  },
  "context": {
    "env": "dev",
    "tier": "tier_1",
    "trust": "draft"
  },
  "affordances": [
    {
      "rel": {
        "$slot": "rel",
        "$from": "live.affordances[0].rel",
        "$example": "next"
      },
      "command": {
        "$interpolate": "capcli rule rehearse add_order_priority --env sim",
        "$bindings": {},
        "$example": "capcli rule rehearse add_order_priority --env sim"
      },
      "intent": {
        "$slot": "intent",
        "$from": "live.affordances[0].intent",
        "$example": "Rehearse the planned migration in sim"
      },
      "risk": {
        "$slot": "risk",
        "$from": "live.affordances[0].risk",
        "$example": "safe"
      }
    }
  ]
}
