{
  "$schema": "wireframe/v1",
  "id": "rule.show.refusal.not_found",
  "scenario": {
    "schema_urp": "schema://invoices"
  },
  "target": {
    "$slot": "schema_urp",
    "$from": "scenario.schema_urp",
    "$example": "schema://invoices"
  },
  "command": {
    "$interpolate": "capcli rule show schema --table invoices",
    "$bindings": {},
    "$example": "capcli rule show schema --table invoices"
  },
  "elapsed_ms": {
    "$slot": "elapsed_ms",
    "$from": "live.elapsed_ms",
    "$type": "integer",
    "$example": 74
  },
  "context": {
    "env": "dev",
    "tier": "tier_1",
    "trust": "draft"
  },
  "archetype": "diagnostic",
  "component": {
    "rule": "validation.table_not_found",
    "domain": "validation",
    "culprit": {
      "$slot": "culprit",
      "$from": "live.culprit",
      "$example": "Table 'invoices' has no compiled declaration in this workspace."
    },
    "remedy": "declare the table in schema.yaml, or list compiled targets via 'capcli rule show schema'",
    "target": {
      "$slot": "schema_urp_2",
      "$from": "scenario.schema_urp",
      "$example": "schema://invoices"
    },
    "lookup": {
      "$slot": "lookup",
      "$from": "live.lookup",
      "$example": "compiled schema.yaml v12 (tables: customers, inventory, orders, order_items)"
    }
  }
}
