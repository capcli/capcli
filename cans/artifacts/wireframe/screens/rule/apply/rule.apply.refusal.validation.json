{
  "$schema": "wireframe/v1",
  "id": "rule.apply.refusal.validation",
  "scenario": {
    "schema_urp": "schema://orders",
    "intent": "add priority flag for rush shipping"
  },
  "target": {
    "$slot": "schema_urp",
    "$from": "scenario.schema_urp",
    "$example": "schema://orders"
  },
  "command": {
    "$interpolate": "capcli rule apply schema -m \"{{intent}}\"",
    "$bindings": {
      "intent": "scenario.intent"
    },
    "$example": "capcli rule apply schema -m \"add priority flag for rush shipping\""
  },
  "elapsed_ms": {
    "$slot": "elapsed_ms",
    "$from": "live.elapsed_ms",
    "$type": "integer",
    "$example": 45
  },
  "context": {
    "env": "dev",
    "tier": "tier_1",
    "trust": "draft"
  },
  "archetype": "diagnostic",
  "component": {
    "rule": "validation.gate_2_semantics",
    "domain": "validation",
    "culprit": {
      "$slot": "culprit",
      "$from": "live.culprit",
      "$example": "Indexed column 'prio' does not exist in parent table 'orders'."
    },
    "remedy": "fix the index target to a declared column, then re-run capcli rule validate",
    "lines": [
      {
        "$slot": "lines_0",
        "$from": "live.lines[0]",
        "$example": "--> schema.yaml:60:12"
      },
      {
        "$slot": "lines_1",
        "$from": "live.lines[1]",
        "$example": "idx:"
      },
      {
        "$slot": "lines_2",
        "$from": "live.lines[2]",
        "$example": "- [[prio, status]]"
      },
      {
        "$slot": "lines_3",
        "$from": "live.lines[3]",
        "$example": "^^^^ index_target_missing"
      }
    ]
  }
}
