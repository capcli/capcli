{
  "$schema": "wireframe/v1",
  "id": "rule.validate.refusal.compat",
  "scenario": {
    "pack": "pack/order_sync"
  },
  "target": {
    "$slot": "pack",
    "$from": "scenario.pack",
    "$example": "pack/order_sync"
  },
  "command": {
    "$interpolate": "capcli rule validate packs/order_sync",
    "$bindings": {},
    "$example": "capcli rule validate packs/order_sync"
  },
  "elapsed_ms": {
    "$slot": "elapsed_ms",
    "$from": "live.elapsed_ms",
    "$type": "integer",
    "$example": 242
  },
  "context": {
    "env": "dev",
    "tier": "tier_1",
    "trust": "draft"
  },
  "archetype": "diagnostic",
  "component": {
    "rule": "policy.pack.compat_fail",
    "domain": "policy.pack",
    "culprit": {
      "$slot": "culprit",
      "$from": "live.culprit",
      "$example": "Pack compat failure: pack requires min_kernel_version 2.4 and policy_version 6; workspace runs kernel 2.1 and policy_version 5."
    },
    "remedy": "upgrade the workspace kernel and policy_version, or pick a blueprint compiled against kernel 2.1 and policy_version 5",
    "pack": {
      "$slot": "pack_2",
      "$from": "scenario.pack",
      "$example": "pack/order_sync"
    },
    "min_kernel_version_required": {
      "$slot": "min_kernel_version_required",
      "$from": "live.min_kernel_version_required",
      "$example": "2.4"
    },
    "min_kernel_version_workspace": {
      "$slot": "min_kernel_version_workspace",
      "$from": "live.min_kernel_version_workspace",
      "$example": "2.1"
    },
    "policy_version_required": {
      "$slot": "policy_version_required",
      "$from": "live.policy_version_required",
      "$example": "6"
    },
    "policy_version_workspace": {
      "$slot": "policy_version_workspace",
      "$from": "live.policy_version_workspace",
      "$example": "5"
    },
    "lines": [
      {
        "$slot": "lines_0",
        "$from": "live.lines[0]",
        "$example": "FATAL  policy.pack.compat_fail"
      },
      {
        "$slot": "lines_1",
        "$from": "live.lines[1]",
        "$example": "Pack requires kernel 2.4 and policy_version 6."
      },
      {
        "$slot": "lines_2",
        "$from": "live.lines[2]",
        "$example": "Workspace runs kernel 2.1 and policy_version 5."
      }
    ]
  }
}
