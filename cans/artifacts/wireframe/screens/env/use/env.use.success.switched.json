{
  "$schema": "wireframe/v1",
  "id": "env.use.success.switched",
  "scenario": {
    "env": "sim"
  },
  "target": {
    "$slot": "env",
    "$from": "scenario.env",
    "$example": "sim"
  },
  "command": {
    "$interpolate": "capcli env use {{env}}",
    "$bindings": {
      "env": "scenario.env"
    },
    "$example": "capcli env use sim"
  },
  "elapsed_ms": {
    "$slot": "elapsed_ms",
    "$from": "live.elapsed_ms",
    "$type": "integer",
    "$example": 685
  },
  "context": {
    "env": "sim",
    "tier": "tier_1",
    "trust": "reviewed"
  },
  "archetype": "receipt",
  "component": {
    "title": null,
    "groups": [
      {
        "fields": {
          "env": {
            "$slot": "env_2",
            "$from": "scenario.env",
            "$example": "sim"
          },
          "sticky_context": {
            "$interpolate": "active (subsequent commands target {{env}})",
            "$bindings": {
              "env": "scenario.env"
            },
            "$example": "active (subsequent commands target sim)"
          },
          "workspace": {
            "$slot": "workspace",
            "$from": "live.groups[0].fields.workspace",
            "$example": "envs/sim/workspace.db"
          },
          "data_source": {
            "$slot": "data_source",
            "$from": "live.groups[0].fields.data_source",
            "$example": "forked from prod via snap_migration_001"
          },
          "masking": {
            "$slot": "masking",
            "$from": "live.groups[0].fields.masking",
            "$example": "fpa_active (customer_email -> anon_*@sim.local)"
          },
          "egress": {
            "$interpolate": "isolated (apis/stripe.{{env}}.yaml overlay)",
            "$bindings": {
              "env": "scenario.env"
            },
            "$example": "isolated (apis/stripe.sim.yaml overlay)"
          },
          "audit": {
            "$slot": "audit",
            "$from": "live.groups[0].fields.audit",
            "$example": "op_6b21 (env.use committed to _audit)"
          }
        }
      }
    ]
  },
  "affordances": [
    {
      "rel": {
        "$slot": "rel",
        "$from": "live.affordances[0].rel",
        "$example": "next"
      },
      "command": {
        "$interpolate": "capcli env list",
        "$bindings": {},
        "$example": "capcli env list"
      },
      "intent": {
        "$slot": "intent",
        "$from": "live.affordances[0].intent",
        "$example": "Environments listed"
      },
      "risk": {
        "$slot": "risk",
        "$from": "live.affordances[0].risk",
        "$example": "safe"
      }
    }
  ]
}
