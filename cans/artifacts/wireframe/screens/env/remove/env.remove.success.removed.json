{
  "$schema": "wireframe/v1",
  "id": "env.remove.success.removed",
  "scenario": {
    "environment": "experiment_2"
  },
  "target": {
    "$slot": "environment",
    "$from": "scenario.environment",
    "$example": "experiment_2"
  },
  "command": {
    "$interpolate": "capcli env remove {{environment}}",
    "$bindings": {
      "environment": "scenario.environment"
    },
    "$example": "capcli env remove experiment_2"
  },
  "elapsed_ms": {
    "$slot": "elapsed_ms",
    "$from": "live.elapsed_ms",
    "$type": "integer",
    "$example": 403
  },
  "context": {
    "env": "dev",
    "tier": "tier_1",
    "trust": "draft"
  },
  "archetype": "receipt",
  "component": {
    "title": null,
    "groups": [
      {
        "fields": {
          "environment": {
            "$slot": "environment_2",
            "$from": "scenario.environment",
            "$example": "experiment_2"
          },
          "final_backup": {
            "$slot": "final_backup",
            "$from": "live.groups[0].fields.final_backup",
            "$example": "pushed (snap_experiment_2_final to git and object store)"
          },
          "dump": {
            "$slot": "dump",
            "$from": "live.groups[0].fields.dump",
            "$example": "exported (dumps/experiment_2.world.sql)"
          },
          "worktree": {
            "$slot": "worktree",
            "$from": "live.groups[0].fields.worktree",
            "$example": "envs/experiment_2/ dismantled (branch envs/experiment_2 deleted)"
          },
          "freed": {
            "$slot": "freed",
            "$from": "live.groups[0].fields.freed",
            "$example": "1 slot (environments: 4 of 5)"
          },
          "audit": {
            "$slot": "audit",
            "$from": "live.groups[0].fields.audit",
            "$example": "op_d2a9 (env.remove committed to _audit)"
          }
        }
      }
    ]
  }
}
