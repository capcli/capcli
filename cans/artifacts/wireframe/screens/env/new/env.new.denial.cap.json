{
  "$schema": "wireframe/v1",
  "id": "env.new.denial.cap",
  "scenario": {
    "experiment_3": "experiment_3"
  },
  "target": {
    "$slot": "experiment_3",
    "$from": "scenario.experiment_3",
    "$example": "experiment_3"
  },
  "command": {
    "$interpolate": "capcli env new {{experiment_3}} --seed prod",
    "$bindings": {
      "experiment_3": "scenario.experiment_3"
    },
    "$example": "capcli env new experiment_3 --seed prod"
  },
  "elapsed_ms": {
    "$slot": "elapsed_ms",
    "$from": "live.elapsed_ms",
    "$type": "integer",
    "$example": 141
  },
  "context": {
    "env": "dev",
    "tier": "tier_1",
    "trust": "draft"
  },
  "archetype": "diagnostic",
  "component": {
    "rule": "policy.env.max_environments",
    "domain": "policy.authorizer",
    "layer": "authorizer",
    "culprit": {
      "$slot": "culprit",
      "$from": "live.culprit",
      "$example": "Environment capacity reached: all namespaces registered."
    },
    "measured": {
      "$slot": "measured",
      "$from": "live.measured",
      "$example": "environments: 5 of 5 (cap: 5)"
    },
    "remedy": "dismantle an unused environment (capcli env remove <name>) before provisioning another; limit: artifacts/governance.yaml#env.max_environments",
    "request": {
      "$interpolate": "env new {{experiment_3}} (seed: prod)",
      "$bindings": {
        "experiment_3": "scenario.experiment_3"
      },
      "$example": "env new experiment_3 (seed: prod)"
    },
    "existing": {
      "$slot": "existing",
      "$from": "live.existing",
      "$example": "prod, dev, sim, staging, experiment_2"
    }
  }
}
