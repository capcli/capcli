{
  "$schema": "wireframe/v1",
  "id": "env.new.success.created",
  "scenario": {
    "name": "staging"
  },
  "target": {
    "$slot": "name",
    "$from": "scenario.name",
    "$example": "staging"
  },
  "command": {
    "$interpolate": "capcli env new {{name}} --seed prod",
    "$bindings": {
      "name": "scenario.name"
    },
    "$example": "capcli env new staging --seed prod"
  },
  "elapsed_ms": {
    "$slot": "elapsed_ms",
    "$from": "live.elapsed_ms",
    "$type": "integer",
    "$example": 275
  },
  "context": {
    "env": "dev",
    "tier": "tier_1",
    "trust": "draft"
  },
  "archetype": "receipt",
  "component": {
    "title": null,
    "groups": [
      {
        "fields": {
          "name": {
            "$slot": "name_2",
            "$from": "scenario.name",
            "$example": "staging"
          },
          "worktree": {
            "$slot": "worktree",
            "$from": "live.groups[0].fields.worktree",
            "$example": "envs/staging/ (isolated git worktree, branch envs/staging)"
          },
          "workspace": {
            "$slot": "workspace",
            "$from": "live.groups[0].fields.workspace",
            "$example": "envs/staging/workspace.db (gitignored runtime state)"
          },
          "seed_source": {
            "$slot": "seed_source",
            "$from": "live.groups[0].fields.seed_source",
            "$example": "envs/prod/workspace.db via snap_seed_staging_01"
          },
          "masking": {
            "$slot": "masking",
            "$from": "live.groups[0].fields.masking",
            "$example": "fpa_active (sensitive columns anonymized on fork)"
          },
          "capacity": {
            "$slot": "capacity",
            "$from": "live.groups[0].fields.capacity",
            "$example": "5 of 5 environments in use"
          },
          "audit": {
            "$slot": "audit",
            "$from": "live.groups[0].fields.audit",
            "$example": "op_3f1a (env.new committed to _audit)"
          }
        }
      }
    ]
  }
}
