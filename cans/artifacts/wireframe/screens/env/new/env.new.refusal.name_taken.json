{
  "$schema": "wireframe/v1",
  "id": "env.new.refusal.name_taken",
  "scenario": {
    "staging": "staging"
  },
  "target": {
    "$slot": "staging",
    "$from": "scenario.staging",
    "$example": "staging"
  },
  "command": {
    "$interpolate": "capcli env new {{staging}} --seed prod",
    "$bindings": {
      "staging": "scenario.staging"
    },
    "$example": "capcli env new staging --seed prod"
  },
  "elapsed_ms": {
    "$slot": "elapsed_ms",
    "$from": "live.elapsed_ms",
    "$type": "integer",
    "$example": 195
  },
  "context": {
    "env": "dev",
    "tier": "tier_1",
    "trust": "draft"
  },
  "archetype": "diagnostic",
  "component": {
    "rule": "validation.env.name_collision",
    "domain": "validation",
    "culprit": {
      "$slot": "culprit",
      "$from": "live.culprit",
      "$example": "Environment name already registered under envs/staging/."
    },
    "remedy": "choose a different environment name, or switch to the existing namespace (capcli env use staging)",
    "request": {
      "$interpolate": "env new {{staging}} (seed: prod)",
      "$bindings": {
        "staging": "scenario.staging"
      },
      "$example": "env new staging (seed: prod)"
    }
  }
}
