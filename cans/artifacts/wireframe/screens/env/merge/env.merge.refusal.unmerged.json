{
  "$schema": "wireframe/v1",
  "id": "env.merge.refusal.unmerged",
  "scenario": {
    "prod": "prod",
    "intent": "forward DDL"
  },
  "target": {
    "$slot": "prod",
    "$from": "scenario.prod",
    "$example": "prod"
  },
  "command": {
    "$interpolate": "capcli env merge dev {{prod}} -m \"{{intent}}\"",
    "$bindings": {
      "prod": "scenario.prod",
      "intent": "scenario.intent"
    },
    "$example": "capcli env merge dev prod -m \"forward DDL\""
  },
  "elapsed_ms": {
    "$slot": "elapsed_ms",
    "$from": "live.elapsed_ms",
    "$type": "integer",
    "$example": 217
  },
  "context": {
    "env": "dev",
    "tier": "tier_1",
    "trust": "draft"
  },
  "archetype": "diagnostic",
  "component": {
    "domain": "compile",
    "culprit": {
      "$slot": "culprit",
      "$from": "live.culprit",
      "$example": "Git branch conflict blocks DDL forwarding: envs/dev and envs/prod diverge on schema.yaml."
    },
    "remedy": "resolve the conflicting schema.yaml edits in the dev worktree, verify with capcli rule diff --git, then retry the merge",
    "request": {
      "$interpolate": "env merge dev {{prod}} (migration: schema_v3)",
      "$bindings": {
        "prod": "scenario.prod"
      },
      "$example": "env merge dev prod (migration: schema_v3)"
    },
    "branch_conflict": {
      "$slot": "branch_conflict",
      "$from": "live.branch_conflict",
      "$example": "envs/dev and envs/prod diverge on schema.yaml."
    },
    "lines": [
      {
        "$slot": "lines_0",
        "$from": "live.lines[0]",
        "$example": "FATAL  compile.git.merge_conflict"
      },
      {
        "$slot": "lines_1",
        "$from": "live.lines[1]",
        "$example": "(conflicting edits to table orders)"
      }
    ]
  }
}
