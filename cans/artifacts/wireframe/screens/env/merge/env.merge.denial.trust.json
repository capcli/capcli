{
  "$schema": "wireframe/v1",
  "id": "env.merge.denial.trust",
  "scenario": {
    "prod": "prod",
    "intent": "forward DDL"
  },
  "target": {
    "$slot": "prod",
    "$from": "scenario.prod",
    "$example": "prod"
  },
  "command": {
    "$interpolate": "capcli env merge dev {{prod}} -m \"{{intent}}\"",
    "$bindings": {
      "prod": "scenario.prod",
      "intent": "scenario.intent"
    },
    "$example": "capcli env merge dev prod -m \"forward DDL\""
  },
  "elapsed_ms": {
    "$slot": "elapsed_ms",
    "$from": "live.elapsed_ms",
    "$type": "integer",
    "$example": 209
  },
  "context": {
    "env": "dev",
    "tier": "tier_1",
    "trust": "draft"
  },
  "archetype": "diagnostic",
  "component": {
    "rule": "policy.trust.merge_unreviewed",
    "domain": "policy.trust",
    "layer": "trust",
    "culprit": {
      "$slot": "culprit",
      "$from": "live.culprit",
      "$example": "Production merge requires reviewed trust; migration holds unreviewed draft."
    },
    "measured": {
      "$slot": "measured",
      "$from": "live.measured",
      "$example": "migration trust: draft (requires: reviewed)"
    },
    "remedy": "elevate the schema migration first (capcli routine ship schema_v3 reviewed), then retry the merge",
    "request": {
      "$interpolate": "env merge dev {{prod}} (migration: schema_v3)",
      "$bindings": {
        "prod": "scenario.prod"
      },
      "$example": "env merge dev prod (migration: schema_v3)"
    },
    "lines": [
      {
        "$slot": "lines_0",
        "$from": "live.lines[0]",
        "$example": "layer:           trust"
      },
      {
        "$slot": "lines_1",
        "$from": "live.lines[1]",
        "$example": "measured:        migration trust: draft (requires: reviewed)"
      }
    ]
  }
}
