{
  "$schema": "wireframe/v1",
  "id": "env.merge.refusal.plan_conflict",
  "scenario": {
    "env_urp": "env://stg"
  },
  "target": {
    "$slot": "env_urp",
    "$from": "scenario.env_urp",
    "$example": "env://stg"
  },
  "command": {
    "$interpolate": "capcli env merge stg --into dev",
    "$bindings": {},
    "$example": "capcli env merge stg --into dev"
  },
  "elapsed_ms": {
    "$slot": "elapsed_ms",
    "$from": "live.elapsed_ms",
    "$type": "integer",
    "$example": 51
  },
  "context": {
    "env": "dev",
    "tier": "tier_1",
    "trust": "draft"
  },
  "archetype": "diagnostic",
  "component": {
    "rule": "compile.plan_conflict",
    "domain": "compile",
    "culprit": {
      "$slot": "culprit",
      "$from": "live.culprit",
      "$example": "Target schema migration plan conflict blocks DDL: column orders.total has two pending migrations (m_014, m_017)"
    },
    "remedy": "resolve the migration plan conflict in declaration order, then re-run 'capcli env merge stg --into dev'",
    "target": {
      "$interpolate": "{{env_urp}} → dev",
      "$bindings": {
        "env_urp": "scenario.env_urp"
      },
      "$example": "env://stg → dev"
    },
    "orders_total_column": {
      "$slot": "orders_total_column",
      "$from": "live.orders_total_column",
      "$example": "pending migrations m_014, m_017 both alter the same DDL span"
    },
    "lines": [
      {
        "$slot": "lines_0",
        "$from": "live.lines[0]",
        "$example": "Target schema migration plan conflict blocks DDL."
      }
    ]
  }
}
