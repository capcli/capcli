{
  "$schema": "wireframe/v1",
  "id": "env.merge.refusal.lockfile",
  "scenario": {
    "prod": "prod",
    "intent": "forward DDL"
  },
  "target": {
    "$slot": "prod",
    "$from": "scenario.prod",
    "$example": "prod"
  },
  "command": {
    "$interpolate": "capcli env merge dev {{prod}} -m \"{{intent}}\"",
    "$bindings": {
      "prod": "scenario.prod",
      "intent": "scenario.intent"
    },
    "$example": "capcli env merge dev prod -m \"forward DDL\""
  },
  "elapsed_ms": {
    "$slot": "elapsed_ms",
    "$from": "live.elapsed_ms",
    "$type": "integer",
    "$example": 75
  },
  "context": {
    "env": "dev",
    "tier": "tier_1",
    "trust": "draft"
  },
  "archetype": "diagnostic",
  "component": {
    "domain": "lockfile_mismatch",
    "culprit": {
      "$slot": "culprit",
      "$from": "live.culprit",
      "$example": "Lockfile out of sync: compiled declaration hashes differ from capcli.lock."
    },
    "remedy": "resync capcli.lock with the compiled declarations (capcli rule validate, then kernel auto-commit) and retry the merge",
    "request": {
      "$interpolate": "env merge dev {{prod}} (migration: schema_v3)",
      "$bindings": {
        "prod": "scenario.prod"
      },
      "$example": "env merge dev prod (migration: schema_v3)"
    },
    "lockfile_sync": {
      "$slot": "lockfile_sync",
      "$from": "live.lockfile_sync",
      "$example": "compiled declaration hashes differ from capcli.lock."
    },
    "computed": {
      "$slot": "computed",
      "$from": "live.computed",
      "$example": "sha256:9e21c4f7aa03"
    },
    "lockfile": {
      "$slot": "lockfile",
      "$from": "live.lockfile",
      "$example": "sha256:4a8f9c2d11b6"
    },
    "lines": [
      {
        "$slot": "lines_0",
        "$from": "live.lines[0]",
        "$example": "FATAL  lockfile_mismatch.root_hash"
      }
    ]
  }
}
