{
  "$schema": "wireframe/v1",
  "id": "env.inspect.success.populated",
  "scenario": {
    "environment": "staging"
  },
  "target": {
    "$slot": "environment",
    "$from": "scenario.environment",
    "$example": "staging"
  },
  "command": {
    "$interpolate": "capcli env inspect {{environment}}",
    "$bindings": {
      "environment": "scenario.environment"
    },
    "$example": "capcli env inspect staging"
  },
  "elapsed_ms": {
    "$slot": "elapsed_ms",
    "$from": "live.elapsed_ms",
    "$type": "integer",
    "$example": 1446
  },
  "context": {
    "env": "dev",
    "tier": "tier_1",
    "trust": "draft",
    "data_shape": {
      "$slot": "data_shape",
      "$from": "context.data_shape",
      "$example": "populated"
    }
  },
  "archetype": "receipt",
  "component": {
    "title": null,
    "groups": [
      {
        "fields": {
          "environment": {
            "$slot": "environment_2",
            "$from": "scenario.environment",
            "$example": "staging"
          },
          "workspace": {
            "$slot": "workspace",
            "$from": "live.groups[0].fields.workspace",
            "$example": "envs/staging/workspace.db"
          },
          "health": {
            "$slot": "health",
            "$from": "live.groups[0].fields.health",
            "$example": "nominal (kernel reachable, WAL journal active)"
          },
          "staleness": {
            "$slot": "staleness",
            "$from": "live.groups[0].fields.staleness",
            "$example": "fresh (seeded 2d ago from snap_seed_staging_01)"
          },
          "drift": {
            "$slot": "drift",
            "$from": "live.groups[0].fields.drift",
            "$example": "2 DDL statements ahead of prod (unmerged)"
          },
          "worktree": {
            "$slot": "worktree",
            "$from": "live.groups[0].fields.worktree",
            "$example": "clean (branch envs/staging @ 4c89a0b1)"
          },
          "audit": {
            "$slot": "audit",
            "$from": "live.groups[0].fields.audit",
            "$example": "op_8c4e (env.inspect, read-only)"
          }
        }
      }
    ]
  }
}
