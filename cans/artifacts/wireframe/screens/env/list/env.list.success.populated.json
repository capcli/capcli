{
  "$schema": "wireframe/v1",
  "id": "env.list.success.populated",
  "command": {
    "$interpolate": "capcli env list",
    "$bindings": {},
    "$example": "capcli env list"
  },
  "elapsed_ms": {
    "$slot": "elapsed_ms",
    "$from": "live.elapsed_ms",
    "$type": "integer",
    "$example": 2166
  },
  "context": {
    "env": "dev",
    "tier": "tier_1",
    "trust": "draft",
    "data_shape": {
      "$slot": "data_shape",
      "$from": "context.data_shape",
      "$example": "populated"
    }
  },
  "archetype": "tree",
  "component": {
    "title": {
      "$slot": "title",
      "$from": "live.list.title",
      "$example": "populated"
    },
    "root": {
      "$slot": "root",
      "$from": "live.list.root",
      "$example": "envs/"
    },
    "nodes": [
      {
        "label": {
          "$slot": "n0",
          "$from": "live.list.nodes[0].label",
          "$example": "prod pinned clean envs/prod/workspace.db"
        },
        "children": []
      },
      {
        "label": {
          "$slot": "n1",
          "$from": "live.list.nodes[1].label",
          "$example": "dev draft clean envs/dev/workspace.db [active]"
        },
        "children": []
      },
      {
        "label": {
          "$slot": "n2",
          "$from": "live.list.nodes[2].label",
          "$example": "sim reviewed stale 16d envs/sim/workspace.db"
        },
        "children": []
      },
      {
        "label": {
          "$slot": "n3",
          "$from": "live.list.nodes[3].label",
          "$example": "seed snap_migration_001 (16d old, re-seed nag at 14d)"
        },
        "children": []
      },
      {
        "label": {
          "$slot": "n4",
          "$from": "live.list.nodes[4].label",
          "$example": "staging draft clean envs/staging/workspace.db"
        },
        "children": []
      },
      {
        "label": {
          "$slot": "n5",
          "$from": "live.list.nodes[5].label",
          "$example": "experiment_2 draft clean envs/experiment_2/workspace.db"
        },
        "children": []
      }
    ],
    "footer": {
      "environments": {
        "$slot": "environments",
        "$from": "live.list.footer.environments",
        "$example": "5 (cap: 5)"
      },
      "sticky": {
        "$slot": "sticky",
        "$from": "live.list.footer.sticky",
        "$example": "dev"
      }
    }
  }
}
