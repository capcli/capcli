{
  "$schema": "wireframe/v1",
  "id": "env.doctor.denial.drift",
  "command": {
    "$interpolate": "capcli env doctor",
    "$bindings": {},
    "$example": "capcli env doctor"
  },
  "elapsed_ms": {
    "$slot": "elapsed_ms",
    "$from": "live.elapsed_ms",
    "$type": "integer",
    "$example": 228
  },
  "context": {
    "env": "dev",
    "tier": "tier_1",
    "trust": "draft"
  },
  "archetype": "diagnostic",
  "component": {
    "rule": "policy.env.schema_drift",
    "domain": "policy.authorizer",
    "layer": "authorizer",
    "culprit": {
      "$slot": "culprit",
      "$from": "live.culprit",
      "$example": "Schema divergence detected: live objects differ from compiled declaration."
    },
    "measured": {
      "$slot": "measured",
      "$from": "live.measured",
      "$example": "drift delta: 2 undeclared columns (orders.rush_flag, orders.priority)"
    },
    "remedy": "reconcile the divergence (capcli rule diff, then capcli rule apply --type schema) or restore the last snapshot",
    "request": {
      "$slot": "request",
      "$from": "live.request",
      "$example": "env doctor (scope: all registered environments)"
    },
    "schema_divergence": {
      "$slot": "schema_divergence",
      "$from": "live.schema_divergence",
      "$example": "live objects differ from compiled declaration."
    },
    "envs/dev/workspace.db": {
      "$slot": "envs_dev_workspace_db",
      "$from": "live.envs_dev_workspace_db",
      "$example": "2 undeclared columns on table orders"
    },
    "lines": [
      {
        "$slot": "lines_0",
        "$from": "live.lines[0]",
        "$example": "layer:           authorizer"
      },
      {
        "$slot": "lines_1",
        "$from": "live.lines[1]",
        "$example": "measured:        drift delta: 2 undeclared columns (orders.rush_flag, orders.priority)"
      }
    ]
  }
}
