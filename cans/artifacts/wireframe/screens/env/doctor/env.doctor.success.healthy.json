{
  "$schema": "wireframe/v1",
  "id": "env.doctor.success.healthy",
  "command": {
    "$interpolate": "capcli env doctor",
    "$bindings": {},
    "$example": "capcli env doctor"
  },
  "elapsed_ms": {
    "$slot": "elapsed_ms",
    "$from": "live.elapsed_ms",
    "$type": "integer",
    "$example": 1194
  },
  "context": {
    "env": "dev",
    "tier": "tier_1",
    "trust": "draft"
  },
  "archetype": "receipt",
  "component": {
    "title": null,
    "groups": [
      {
        "fields": {
          "scope": {
            "$slot": "scope",
            "$from": "live.groups[0].fields.scope",
            "$example": "all registered environments (5)"
          },
          "schema": {
            "$slot": "schema",
            "$from": "live.groups[0].fields.schema",
            "$example": "verified (live PRAGMA scan matches compiled schema.yaml)"
          },
          "worktree": {
            "$slot": "worktree",
            "$from": "live.groups[0].fields.worktree",
            "$example": "clean (no uncommitted governed files)"
          },
          "unmerged": {
            "$slot": "unmerged",
            "$from": "live.groups[0].fields.unmerged",
            "$example": "none (no dev DDL pending prod promotion)"
          },
          "lockfile": {
            "$slot": "lockfile",
            "$from": "live.groups[0].fields.lockfile",
            "$example": "capcli.lock verified (sha256:4a8f9c2d11b6)"
          },
          "backup": {
            "$slot": "backup",
            "$from": "live.groups[0].fields.backup",
            "$example": "fresh (last push 4m ago, mandate: 30m)"
          },
          "audit": {
            "$slot": "audit",
            "$from": "live.groups[0].fields.audit",
            "$example": "op_2d77 (env.doctor, read-only)"
          }
        }
      }
    ]
  }
}
