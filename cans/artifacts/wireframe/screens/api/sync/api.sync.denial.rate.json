{
  "$schema": "wireframe/v1",
  "id": "api.sync.denial.rate",
  "scenario": {
    "highlight": "stripe"
  },
  "target": {
    "$slot": "highlight",
    "$from": "scenario.highlight",
    "$example": "stripe"
  },
  "command": {
    "$interpolate": "capcli api sync {{highlight}} https://api.stripe.com/openapi.json --interval 7d",
    "$bindings": {
      "highlight": "scenario.highlight"
    },
    "$example": "capcli api sync stripe https://api.stripe.com/openapi.json --interval 7d"
  },
  "elapsed_ms": {
    "$slot": "elapsed_ms",
    "$from": "live.elapsed_ms",
    "$type": "integer",
    "$example": 350
  },
  "context": {
    "env": "dev",
    "tier": "tier_1",
    "trust": "draft"
  },
  "archetype": "diagnostic",
  "component": {
    "rule": "api.quota.rate_limit",
    "domain": "api.quota",
    "layer": "quota",
    "culprit": {
      "$interpolate": "Sync call within 24h cooldown for provider '{{highlight}}'.",
      "$bindings": {
        "highlight": "scenario.highlight"
      },
      "$example": "Sync call within 24h cooldown for provider 'stripe'."
    },
    "measured": {
      "$slot": "measured",
      "$from": "live.measured",
      "$example": "last sync completed 18h 24m ago (cooldown remaining: 5h 36m)"
    },
    "remedy": "wait for the 24h cooldown to reset, or inspect the live catalog via 'capcli api catalog stripe'",
    "span": {
      "source": {
        "$interpolate": "capcli api sync {{highlight}} https://api.{{highlight}}.com/openapi.json",
        "$bindings": {
          "highlight": "scenario.highlight"
        },
        "$example": "capcli api sync stripe https://api.stripe.com/openapi.json"
      },
      "highlight": {
        "$slot": "highlight_2",
        "$from": "scenario.highlight",
        "$example": "stripe"
      }
    },
    "min_interval_hours": {
      "$slot": "min_interval_hours",
      "$from": "live.min_interval_hours",
      "$example": "24"
    }
  }
}
