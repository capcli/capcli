    },
    "lines": [
      {
        "$slot": "lines_0",
        "$from": "live.lines[0]",
        "$example": "FATAL  missing_param.missing_arg"
      },
      {
        "$slot": "lines_1",
        "$from": "live.lines[1]",
        "$example": "The kernel alone parses OpenAPI specs; compilation requires a spec URL."
      }
    ]
  }
