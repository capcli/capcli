      "$interpolate": "capcli api sync {{stripe}}",
      "$bindings": {
        "stripe": "scenario.stripe"
      },
      "$example": "capcli api sync stripe"
    },
    "usage": {
      "$slot": "usage",
      "$from": "live.usage",
