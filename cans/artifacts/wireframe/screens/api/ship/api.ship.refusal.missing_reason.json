{
  "$schema": "wireframe/v1",
  "id": "api.ship.refusal.missing_reason",
  "scenario": {
    "routine_urp": "cap://threads.create_media_post"
  },
  "target": {
    "$slot": "routine_urp",
    "$from": "scenario.routine_urp",
    "$example": "cap://threads.create_media_post"
  },
  "command": {
    "$interpolate": "capcli api ship threads.create_media_post reviewed",
    "$bindings": {},
    "$example": "capcli api ship threads.create_media_post reviewed"
  },
  "elapsed_ms": {
    "$slot": "elapsed_ms",
    "$from": "live.elapsed_ms",
    "$type": "integer",
    "$example": 179
  },
  "context": {
    "env": "dev",
    "tier": "tier_1",
    "trust": "draft"
  },
  "archetype": "diagnostic",
  "component": {
    "domain": "missing_param",
    "culprit": {
      "$slot": "culprit",
      "$from": "live.culprit",
      "$example": "Missing elevation justification."
    },
    "remedy": "re-run with --reason stating why the verb is ready for the target rung",
    "command": {
      "$slot": "command",
      "$from": "live.command",
      "$example": "capcli api ship threads.create_media_post reviewed"
    },
    "usage": {
      "$slot": "usage",
      "$from": "live.usage",
      "$example": "capcli api ship <provider.verb> <rung> --reason \"<why>\""
    },
    "lines": [
      {
        "$slot": "lines_0",
        "$from": "live.lines[0]",
        "$example": "FATAL  missing_param.missing_arg"
      },
      {
        "$slot": "lines_1",
        "$from": "live.lines[1]",
        "$example": "Trust elevation requires --reason for the audit trail."
      }
    ]
  }
}
