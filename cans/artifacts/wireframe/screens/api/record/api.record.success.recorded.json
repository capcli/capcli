    "$slot": "audit_op",
    "$from": "live.audit_op",
    "$example": "op_6b34"
  },
  "command": {
    "$interpolate": "capcli api record stripe.charges.create -p charge_id=\"{{charge_id}}\"",
    "$bindings": {
      "charge_id": "scenario.charge_id"
    },
    "$example": "capcli api record stripe.charges.create -p charge_id=\"ch_1032ZX\""
  },
  "elapsed_ms": {
    "$slot": "elapsed_ms",
    "$from": "live.elapsed_ms",
    "$type": "integer",
    "$example": 600
  },
  "component": {
    "groups": [
      {
        "fields": {
          "assertions": {
            "$slot": "assertions",
            "$from": "live.groups[0].fields.assertions",
            "$example": "14 generated"
          },
          "cassette": {
            "$slot": "cassette",
            "$from": "live.groups[0].fields.cassette",
            "$example": "apis/stripe.cassette.jsonl"
          },
          "contract": {
            "$slot": "contract",
            "$from": "live.groups[0].fields.contract",
            "$example": "strict JSON Schema compiled from live response"
          },
          "live_response": {
            "$slot": "live_response",
            "$from": "live.groups[0].fields.live_response",
            "$example": "200 (captured)"
          },
          "request": {
            "$interpolate": "charge_id: {{charge_id}}",
            "$bindings": {
              "charge_id": "scenario.charge_id"
            },
            "$example": "charge_id: ch_1032ZX"
          },
          "verb": {
            "$slot": "api_verb",
            "$from": "live.api_verb",
            "$example": "cap://stripe.charges.create"
          }
        }
      }
    ],
    "title": null
  },
  "context": {
    "env": "dev",
    "tier": "tier_1",
    "trust": "draft"
  },
  "target": {
    "$slot": "routine_urp",
    "$from": "scenario.routine_urp",
    "$example": "cap://stripe.charges.create"
  },
  "affordances": [
    {
      "rel": {
        "$slot": "rel",
        "$from": "live.affordances[0].rel",
        "$example": "next"
      },
      "command": {
        "$interpolate": "capcli api catalog stripe --state active --json",
        "$bindings": {},
        "$example": "capcli api catalog stripe --state active --json"
      },
      "intent": {
        "$slot": "intent",
        "$from": "live.affordances[0].intent",
        "$example": "Confirm the recorded contract sits in the catalog"
      },
      "risk": {
        "$slot": "risk",
        "$from": "live.affordances[0].risk",
        "$example": "safe"
      }
    }
  ]
