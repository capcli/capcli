{
  "$schema": "wireframe/v1",
  "id": "api.rollback.success.completed",
  "scenario": {
    "routine_urp": "cap://threads.create_media_post"
  },
  "target": {
    "$slot": "routine_urp",
    "$from": "scenario.routine_urp",
    "$example": "cap://threads.create_media_post"
  },
  "command": {
    "$interpolate": "capcli api rollback threads.create_media_post 4",
    "$bindings": {},
    "$example": "capcli api rollback threads.create_media_post 4"
  },
  "elapsed_ms": {
    "$slot": "elapsed_ms",
    "$from": "live.elapsed_ms",
    "$type": "integer",
    "$example": 694
  },
  "context": {
    "env": "dev",
    "tier": "tier_1",
    "trust": "draft"
  },
  "audit_op": {
    "$slot": "audit_op",
    "$from": "live.audit_op",
    "$example": "op_7c4e9"
  },
  "archetype": "receipt",
  "component": {
    "title": null,
    "groups": [
      {
        "fields": {
          "verb": {
            "$slot": "api_verb",
            "$from": "live.api_verb",
            "$example": "cap://threads.create_media_post"
          },
          "version": {
            "$slot": "version",
            "$from": "live.groups[0].fields.version",
            "$example": "8 → 4"
          },
          "spec_hash": {
            "$slot": "spec_hash",
            "$from": "live.groups[0].fields.spec_hash",
            "$example": "sha256:9d4f2c7b8e1a6f04c3d5b8a9e2f1c7d4b6a3e5fa (restored)"
          },
          "depth": {
            "$slot": "depth",
            "$from": "live.groups[0].fields.depth",
            "$example": "4 of 5 (max rollback depth)"
          }
        }
      }
    ]
  }
}
