{
  "$schema": "wireframe/v1",
  "id": "pack.bundle.refusal.size_limit",
  "scenario": {
    "pack_atlas_world": "pack/atlas_world"
  },
  "target": {
    "$slot": "pack_atlas_world",
    "$from": "scenario.pack_atlas_world",
    "$example": "pack/atlas_world"
  },
  "command": {
    "$interpolate": "capcli pack bundle packs/atlas_world",
    "$bindings": {},
    "$example": "capcli pack bundle packs/atlas_world"
  },
  "elapsed_ms": {
    "$slot": "elapsed_ms",
    "$from": "live.elapsed_ms",
    "$type": "integer",
    "$example": 304
  },
  "context": {
    "env": "dev",
    "tier": "tier_1",
    "trust": "draft"
  },
  "archetype": "diagnostic",
  "component": {
    "rule": "policy.pack.size_limit",
    "domain": "policy.pack",
    "layer": "authorizer",
    "culprit": {
      "$slot": "culprit",
      "$from": "live.culprit",
      "$example": "World pack bundle measures 7.2MB, over the 5MB ceiling."
    },
    "measured": {
      "$slot": "measured",
      "$from": "live.measured",
      "$example": "bundle: 7.2MB (ceiling: 5MB)"
    },
    "remedy": "prune assets under 5MB or split the bundle, then re-run capcli pack bundle packs/atlas_world",
    "pack": {
      "$slot": "pack",
      "$from": "live.pack",
      "$example": "pack://world/atlas_world"
    },
    "kind": {
      "$slot": "kind",
      "$from": "live.kind",
      "$example": "world"
    },
    "lines": [
      {
        "$slot": "lines_0",
        "$from": "live.lines[0]",
        "$example": "bundle: 7.2MB (ceiling: 5MB)"
      },
      {
        "$slot": "lines_1",
        "$from": "live.lines[1]",
        "$example": "World pack bundle exceeds the size ceiling."
      }
    ]
  }
}
