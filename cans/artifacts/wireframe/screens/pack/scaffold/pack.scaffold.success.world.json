{
  "$schema": "wireframe/v1",
  "id": "pack.scaffold.success.world",
  "scenario": {
    "lab2": "lab2"
  },
  "target": {
    "$slot": "lab2",
    "$from": "scenario.lab2",
    "$example": "lab2"
  },
  "command": {
    "$interpolate": "capcli pack scaffold pack://world/atlas_world {{lab2}}",
    "$bindings": {
      "lab2": "scenario.lab2"
    },
    "$example": "capcli pack scaffold pack://world/atlas_world lab2"
  },
  "elapsed_ms": {
    "$slot": "elapsed_ms",
    "$from": "live.elapsed_ms",
    "$type": "integer",
    "$example": 357
  },
  "context": {
    "env": "dev",
    "tier": "tier_1",
    "trust": "draft"
  },
  "archetype": "receipt",
  "component": {
    "title": null,
    "groups": [
      {
        "fields": {
          "env": {
            "$slot": "env",
            "$from": "live.groups[0].fields.env",
            "$example": "envs/lab2"
          },
          "trust": {
            "$slot": "trust",
            "$from": "live.groups[0].fields.trust",
            "$example": "draft"
          },
          "version": {
            "$slot": "version",
            "$from": "live.groups[0].fields.version",
            "$example": "1"
          },
          "pack.source": {
            "$slot": "pack_source",
            "$from": "live.groups[0].fields.pack_source",
            "$example": "pack://world/atlas_world"
          },
          "pack.hash": {
            "$slot": "pack_hash",
            "$from": "live.groups[0].fields.pack_hash",
            "$example": "sha256:b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4a1"
          }
        }
      },
      {
        "fields": {
          "audit": {
            "$slot": "audit",
            "$from": "live.groups[1].fields.audit",
            "$example": "op_pack_scaffold_02 (env.init_from_pack from pack://world/atlas_world)"
          }
        }
      }
    ]
  },
  "affordances": [
    {
      "rel": {
        "$slot": "rel",
        "$from": "live.affordances[0].rel",
        "$example": "next"
      },
      "command": {
        "$interpolate": "capcli env list",
        "$bindings": {},
        "$example": "capcli env list"
      },
      "intent": {
        "$slot": "intent",
        "$from": "live.affordances[0].intent",
        "$example": "Verify the scaffolded environment is registered"
      },
      "risk": {
        "$slot": "risk",
        "$from": "live.affordances[0].risk",
        "$example": "safe"
      }
    }
  ]
}
