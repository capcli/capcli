{
  "$schema": "wireframe/v1",
  "id": "sys.doctor.denial.drift",
  "scenario": {
    "host": "host"
  },
  "target": {
    "$slot": "host",
    "$from": "scenario.host",
    "$example": "host"
  },
  "command": {
    "$interpolate": "capcli sys doctor",
    "$bindings": {},
    "$example": "capcli sys doctor"
  },
  "elapsed_ms": {
    "$slot": "elapsed_ms",
    "$from": "live.elapsed_ms",
    "$type": "integer",
    "$example": 267
  },
  "context": {
    "env": "dev",
    "tier": "tier_1",
    "trust": "reviewed"
  },
  "archetype": "diagnostic",
  "component": {
    "rule": "policy.authorizer.declaration_drift",
    "domain": "policy.authorizer",
    "layer": "authorizer",
    "culprit": {
      "$slot": "culprit",
      "$from": "live.culprit",
      "$example": "Live DB schema diverges from the compiled declaration (orders.idx_orders_status, customers.region)"
    },
    "measured": {
      "$slot": "measured",
      "$from": "live.measured",
      "$example": "2 drift items (declaration v3 vs envs/dev/workspace.db)"
    },
    "remedy": "reconcile with 'capcli rule diff --git', then 'capcli rule apply schema'",
    "drift": [
      {
        "$slot": "drift_0",
        "$from": "live.drift[0]",
        "$example": "orders.idx_orders_status present in live DB, absent from schema.yaml"
      },
      {
        "$slot": "drift_1",
        "$from": "live.drift[1]",
        "$example": "customers.region declared, missing from live table"
      }
    ],
    "lines": [
      {
        "$slot": "lines_0",
        "$from": "live.lines[0]",
        "$example": "Live DB schema diverges from the compiled declaration."
      },
      {
        "$slot": "lines_1",
        "$from": "live.lines[1]",
        "$example": "Doctor refuses to certify a drifted workspace."
      },
      {
        "$slot": "lines_2",
        "$from": "live.lines[2]",
        "$example": "layer:          authorizer"
      },
      {
        "$slot": "lines_3",
        "$from": "live.lines[3]",
        "$example": "measured:       2 drift items (declaration v3 vs envs/dev/workspace.db)"
      }
    ]
  }
}
