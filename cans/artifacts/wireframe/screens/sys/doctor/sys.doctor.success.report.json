{
  "$schema": "wireframe/v3",
  "screen_id": "sys.doctor.success.report",
  "target": "sys://host",
  "command": "capcli sys doctor --report",
  "state": {
    "exit_code": 0,
    "domain": null,
    "trust": "reviewed",
    "env": "prod",
    "tier": "tier_1",
    "state_modified": false,
    "data_shape": null
  },
  "diagnostic": null,
  "render": {
    "header": "badge",
    "sections": [
      {
        "title": "trust_receipt",
        "fields": [
          "status",
          "host_tier",
          "workspace",
          "ledger_root_hash",
          "audited_events",
          "policy_denials",
          "unaudited_writes",
          "secret_leaks",
          "pinned_routines",
          "active_triggers",
          "sleep_score"
        ]
      }
    ]
  }
}
