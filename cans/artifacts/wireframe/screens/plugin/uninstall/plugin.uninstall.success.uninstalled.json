{
  "$schema": "wireframe/v1",
  "id": "plugin.uninstall.success.uninstalled",
  "scenario": {
    "plugin_id": "stripe-dev"
  },
  "target": {
    "$slot": "plugin_id",
    "$from": "scenario.plugin_id",
    "$example": "stripe-dev"
  },
  "command": {
    "$interpolate": "capcli plugin uninstall {{plugin_id}}",
    "$bindings": {
      "plugin_id": "scenario.plugin_id"
    },
    "$example": "capcli plugin uninstall stripe-dev"
  },
  "elapsed_ms": {
    "$slot": "elapsed_ms",
    "$from": "live.elapsed_ms",
    "$type": "integer",
    "$example": 512
  },
  "context": {
    "env": "dev",
    "tier": "tier_1",
    "trust": "pinned"
  },
  "archetype": "receipt",
  "component": {
    "title": null,
    "groups": [
      {
        "fields": {
          "plugin_id": {
            "$slot": "plugin_id_2",
            "$from": "scenario.plugin_id",
            "$example": "stripe-dev"
          },
          "removed": {
            "$slot": "removed",
            "$from": "live.groups[0].fields.removed",
            "$example": "registration dropped; state dir retained"
          },
          "gc": {
            "$slot": "gc",
            "$from": "live.groups[0].fields.gc",
            "$example": "state reclaimed after lease drop; --purge-state wipes immediately"
          }
        }
      }
    ]
  },
  "affordances": [
    {
      "rel": {
        "$slot": "rel",
        "$from": "live.affordances[0].rel",
        "$example": "next"
      },
      "command": {
        "$interpolate": "capcli plugin list",
        "$bindings": {},
        "$example": "capcli plugin list"
      },
      "intent": {
        "$slot": "intent",
        "$from": "live.affordances[0].intent",
        "$example": "Installed plugin registry"
      },
      "risk": {
        "$slot": "risk",
        "$from": "live.affordances[0].risk",
        "$example": "safe"
      }
    }
  ]
}