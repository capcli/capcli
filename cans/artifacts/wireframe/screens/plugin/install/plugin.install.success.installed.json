{
  "$schema": "wireframe/v1",
  "id": "plugin.install.success.installed",
  "scenario": {
    "plugin_id": "stripe"
  },
  "target": {
    "$slot": "plugin_id",
    "$from": "scenario.plugin_id",
    "$example": "stripe"
  },
  "command": {
    "$interpolate": "capcli plugin install registry:stripe@2.4.0",
    "$bindings": {},
    "$example": "capcli plugin install registry:stripe@2.4.0"
  },
  "elapsed_ms": {
    "$slot": "elapsed_ms",
    "$from": "live.elapsed_ms",
    "$type": "integer",
    "$example": 1180
  },
  "context": {
    "env": "dev",
    "tier": "tier_1",
    "trust": "pinned"
  },
  "archetype": "receipt",
  "component": {
    "title": null,
    "groups": [
      {
        "fields": {
          "plugin_id": {
            "$slot": "plugin_id_2",
            "$from": "scenario.plugin_id",
            "$example": "stripe"
          },
          "version": {
            "$slot": "version",
            "$from": "live.groups[0].fields.version",
            "$example": "2.4.0"
          },
          "source": {
            "$slot": "source",
            "$from": "live.groups[0].fields.source",
            "$example": "registry:stripe@2.4.0"
          },
          "rung": {
            "$slot": "rung",
            "$from": "live.groups[0].fields.rung",
            "$example": "reviewed"
          },
          "generation": {
            "$slot": "generation",
            "$from": "live.groups[0].fields.generation",
            "$example": "gen_03"
          },
          "trust": {
            "$slot": "trust",
            "$from": "live.groups[0].fields.trust",
            "$example": "pinned"
          },
          "preview": {
            "$slot": "preview",
            "$from": "live.groups[0].fields.preview",
            "$example": "mount projection + cli_noun api; no writes until --yes confirmed"
          },
          "audit": {
            "$slot": "audit",
            "$from": "live.groups[0].fields.audit",
            "$example": "op_pl01 committed to _audit"
          }
        }
      }
    ]
  },
  "affordances": [
    {
      "rel": {
        "$slot": "rel",
        "$from": "live.affordances[0].rel",
        "$example": "next"
      },
      "command": {
        "$interpolate": "capcli plugin inspect {{plugin_id}}",
        "$bindings": {
          "plugin_id": "scenario.plugin_id"
        },
        "$example": "capcli plugin inspect stripe"
      },
      "intent": {
        "$slot": "intent",
        "$from": "live.affordances[0].intent",
        "$example": "Plugin preflight envelope"
      },
      "risk": {
        "$slot": "risk",
        "$from": "live.affordances[0].risk",
        "$example": "safe"
      }
    }
  ]
}