{
  "$schema": "wireframe/v1",
  "id": "plugin.doctor.success.healthy",
  "scenario": {
    "plugin_id": "stripe"
  },
  "target": {
    "$slot": "plugin_id",
    "$from": "scenario.plugin_id",
    "$example": "stripe"
  },
  "command": {
    "$interpolate": "capcli plugin doctor {{plugin_id}}",
    "$bindings": {
      "plugin_id": "scenario.plugin_id"
    },
    "$example": "capcli plugin doctor stripe"
  },
  "elapsed_ms": {
    "$slot": "elapsed_ms",
    "$from": "live.elapsed_ms",
    "$type": "integer",
    "$example": 623
  },
  "context": {
    "env": "dev",
    "tier": "tier_1",
    "trust": "pinned"
  },
  "archetype": "receipt",
  "component": {
    "title": null,
    "groups": [
      {
        "fields": {
          "plugin_id": {
            "$slot": "plugin_id_2",
            "$from": "scenario.plugin_id",
            "$example": "stripe"
          },
          "tri_jail": {
            "$slot": "tri_jail",
            "$from": "live.groups[0].fields.tri_jail",
            "$example": "probes pass (fs/net/ipc)"
          },
          "syscall_42": {
            "$slot": "syscall_42",
            "$from": "live.groups[0].fields.syscall_42",
            "$example": "trapping asserted"
          },
          "verdict": {
            "$slot": "verdict",
            "$from": "live.groups[0].fields.verdict",
            "$example": "healthy"
          }
        }
      }
    ]
  },
  "affordances": [
    {
      "rel": {
        "$slot": "rel",
        "$from": "live.affordances[0].rel",
        "$example": "next"
      },
      "command": {
        "$interpolate": "capcli plugin list",
        "$bindings": {},
        "$example": "capcli plugin list"
      },
      "intent": {
        "$slot": "intent",
        "$from": "live.affordances[0].intent",
        "$example": "Installed plugin registry"
      },
      "risk": {
        "$slot": "risk",
        "$from": "live.affordances[0].risk",
        "$example": "safe"
      }
    }
  ]
}