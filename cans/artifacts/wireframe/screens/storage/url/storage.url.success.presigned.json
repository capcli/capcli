{
  "$schema": "wireframe/v1",
  "id": "storage.url.success.presigned",
  "scenario": {
    "key": "reports/r1.pdf"
  },
  "target": {
    "$slot": "key",
    "$from": "scenario.key",
    "$example": "reports/r1.pdf"
  },
  "command": {
    "$interpolate": "capcli storage url {{key}} --ttl 3600",
    "$bindings": {
      "key": "scenario.key"
    },
    "$example": "capcli storage url reports/r1.pdf --ttl 3600"
  },
  "elapsed_ms": {
    "$slot": "elapsed_ms",
    "$from": "live.elapsed_ms",
    "$type": "integer",
    "$example": 88
  },
  "context": {
    "env": "dev",
    "tier": "tier_1",
    "trust": "reviewed"
  },
  "archetype": "receipt",
  "component": {
    "title": null,
    "groups": [
      {
        "fields": {
          "key": {
            "$slot": "key_2",
            "$from": "scenario.key",
            "$example": "reports/r1.pdf"
          },
          "url": {
            "$slot": "url",
            "$from": "live.groups[0].fields.url",
            "$example": "https://objects.capcli.local/reports/r1.pdf?expires=3600&sig=<signature>"
          },
          "expires_in": {
            "$slot": "expires_in",
            "$from": "live.groups[0].fields.expires_in",
            "$example": "3600s"
          }
        }
      }
    ]
  }
}
