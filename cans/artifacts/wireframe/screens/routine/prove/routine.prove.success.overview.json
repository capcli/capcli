{
  "$schema": "wireframe/v1",
  "id": "routine.prove.success.overview",
  "scenario": {
    "overview": "overview"
  },
  "target": {
    "$slot": "overview",
    "$from": "scenario.overview",
    "$example": "overview"
  },
  "command": {
    "$interpolate": "capcli routine prove {{overview}} --env sim",
    "$bindings": {
      "overview": "scenario.overview"
    },
    "$example": "capcli routine prove overview --env sim"
  },
  "elapsed_ms": {
    "$slot": "elapsed_ms",
    "$from": "live.elapsed_ms",
    "$type": "integer",
    "$example": 1361
  },
  "context": {
    "env": "sim",
    "tier": "tier_1",
    "trust": "draft"
  },
  "archetype": "receipt",
  "component": {
    "title": null,
    "groups": [
      {
        "fields": {
          "routine": {
            "$slot": "routine",
            "$from": "live.groups[0].fields.routine",
            "$example": "overview@1 (routine://overview@1 draft)"
          },
          "fingerprint": {
            "$slot": "fingerprint",
            "$from": "live.groups[0].fields.fingerprint",
            "$example": "sha256:c5d2e8f1... (dynamic leaf sequence from _audit mirror)"
          },
          "manifest": {
            "$slot": "manifest",
            "$from": "live.groups[0].fields.manifest",
            "$example": "sha256:8a1b4e77... (declared call sequence via @routine over kernel.sock)"
          },
          "match": {
            "$slot": "match",
            "$from": "live.groups[0].fields.match",
            "$example": "4 executed / 4 declared (subset; 0 undeclared leaves)"
          }
        }
      },
      {
        "fields": {
          "sandbox_rules": {
            "$slot": "sandbox_rules",
            "$from": "live.groups[1].fields.sandbox_rules",
            "$example": "pass (subprocess, os, raw socket trapped by jail)"
          },
          "param_typing": {
            "$slot": "param_typing",
            "$from": "live.groups[1].fields.param_typing",
            "$example": "pass (domain: string)"
          },
          "policy_reachability": {
            "$slot": "policy_reachability",
            "$from": "live.groups[1].fields.policy_reachability",
            "$example": "pass (orders read; domain KPI aggregation only)"
          },
          "shape_limits": {
            "$slot": "shape_limits",
            "$from": "live.groups[1].fields.shape_limits",
            "$example": "pass (44 LOC, 780 tokens, 1 param)"
          },
          "invariant_suite": {
            "$slot": "invariant_suite",
            "$from": "live.groups[1].fields.invariant_suite",
            "$example": "pass (grounding + determinism assertions)"
          }
        },
        "lines": [
          {
            "$slot": "lines_0",
            "$from": "live.groups[1].lines[0]",
            "$example": "checks:"
          }
        ]
      },
      {
        "fields": {
          "note": {
            "$slot": "note",
            "$from": "live.groups[2].fields.note",
            "$example": "verification only; no sim world state committed"
          },
          "audit": {
            "$slot": "audit",
            "$from": "live.groups[2].fields.audit",
            "$example": "op_prove_02"
          }
        }
      }
    ]
  },
  "affordances": [
    {
      "rel": {
        "$slot": "rel",
        "$from": "live.affordances[0].rel",
        "$example": "next"
      },
      "command": {
        "$interpolate": "capcli routine ship {{overview}} reviewed --queue --reason \"sim prove passed\"",
        "$bindings": {
          "overview": "scenario.overview"
        },
        "$example": "capcli routine ship overview reviewed --queue --reason \"sim prove passed\""
      },
      "intent": {
        "$slot": "intent",
        "$from": "live.affordances[0].intent",
        "$example": "Enqueued for human review; zero code shipped"
      },
      "risk": {
        "$slot": "risk",
        "$from": "live.affordances[0].risk",
        "$example": "mutating"
      }
    }
  ]
}
