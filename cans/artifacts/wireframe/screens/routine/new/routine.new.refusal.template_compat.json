{
  "$schema": "wireframe/v2",
  "id": "routine.new.refusal.template_compat",
  "target": "order_sync",
  "command": "capcli routine new order_sync --from tpl://order_sync@2",
  "context": {
    "env": "dev",
    "tier": "tier_1",
    "trust": "draft"
  },
  "archetype": "diagnostic",
  "component": {
    "rule": "policy.template.compat_fail",
    "domain": "policy.template",
    "culprit": "Template policy_version mismatch (template requires policy 5, workspace policy 4)",
    "remedy": "upgrade the workspace policy_version or select a template compiled against policy 4",
    "template": "tpl://order_sync@2 (policy_version 5)",
    "workspace policy_version": "4",
    "lines": [
      "Template policy_version mismatch exits 3."
    ]
  }
}
