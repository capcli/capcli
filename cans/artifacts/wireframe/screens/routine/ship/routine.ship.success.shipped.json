            "$slot": "audit_mode",
            "$from": "live.groups[2].fields.audit_mode",
            "$example": "summary"
          }
        },
        "lines": [
          {
            "$slot": "lines_1",
            "$from": "live.groups[2].lines[0]",
            "$example": "unlocked:"
          }
