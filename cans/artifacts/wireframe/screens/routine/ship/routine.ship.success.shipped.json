{
  "$schema": "wireframe/v1",
  "id": "routine.ship.success.shipped",
  "scenario": {
    "order_sync": "order_sync"
  },
  "target": {
    "$slot": "order_sync",
    "$from": "scenario.order_sync",
    "$example": "order_sync"
  },
  "command": {
    "$interpolate": "capcli routine ship {{order_sync}} pinned --reason \"30d clean canary\"",
