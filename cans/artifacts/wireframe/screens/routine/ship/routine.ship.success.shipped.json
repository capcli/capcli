    "$example": 2398
  },
  "context": {
    "env": "prod",
    "tier": "tier_1",
    "trust": "pinned"
  },
  "archetype": "receipt",
  "component": {
    "title": null,
    "groups": [
      {
        "fields": {
          "routine": {
            "$slot": "routine",
