{
  "$schema": "wireframe/v1",
  "id": "routine.retire.success.completed",
  "scenario": {
    "legacy_etl": "legacy_etl"
  },
  "target": {
    "$slot": "legacy_etl",
    "$from": "scenario.legacy_etl",
    "$example": "legacy_etl"
  },
  "command": {
    "$interpolate": "capcli routine retire {{legacy_etl}} --reason \"replaced by unified pipeline\"",
    "$bindings": {
      "legacy_etl": "scenario.legacy_etl"
    },
    "$example": "capcli routine retire legacy_etl --reason \"replaced by unified pipeline\""
  },
  "elapsed_ms": {
    "$slot": "elapsed_ms",
    "$from": "live.elapsed_ms",
    "$type": "integer",
    "$example": 1627
  },
  "context": {
    "env": "prod",
    "tier": "tier_1",
    "trust": "pinned"
  },
  "archetype": "receipt",
  "component": {
    "title": null,
    "groups": [
      {
        "fields": {
          "routine": {
            "$slot": "routine",
            "$from": "live.groups[0].fields.routine",
            "$example": "legacy_etl@6"
          },
          "state": {
            "$slot": "state",
            "$from": "live.groups[0].fields.state",
            "$example": "active -> retired"
          },
          "reason": {
            "$slot": "reason",
            "$from": "live.groups[0].fields.reason",
            "$example": "\"replaced by unified pipeline\""
          }
        }
      },
      {
        "fields": {
          "orphan_trigger_warning": {
            "$slot": "orphan_trigger_warning",
            "$from": "live.groups[1].fields.orphan_trigger_warning",
            "$example": "retiring legacy_etl@6 dissolves its 2 bound ingress routes in the same commit; no trigger outlives the routine"
          },
          "cron binding": {
            "$slot": "cron_binding",
            "$from": "live.groups[1].fields.cron_binding",
            "$example": "bnd_3k2f \"legacy_etl_nightly\" (0 4 * * *) dissolved atomically at retire time — no pause, no next tick"
          },
          "endpoint binding": {
            "$slot": "endpoint_binding",
            "$from": "live.groups[1].fields.endpoint_binding",
            "$example": "bnd_8d3p legacy_etl@6 (http://127.0.0.1:4040/endpoints/legacy_etl, api-key) dissolved with the retire commit — retired = uncallable"
          },
          "audit events": {
            "$slot": "audit_events",
            "$from": "live.groups[1].fields.audit_events",
            "$example": "op_retire_01 (routine.retire committed) + bind.delete events for bnd_3k2f and bnd_8d3p in _audit in the same op batch"
          }
        }
      },
      {
        "fields": {
          "callers": {
            "$slot": "callers",
            "$from": "live.groups[2].fields.callers",
            "$example": "none (dependency graph clear)"
          },
          "audit": {
            "$slot": "audit",
            "$from": "live.groups[2].fields.audit",
            "$example": "op_retire_01 (routine.retire committed; provenance graph preserved)"
          },
          "note": {
            "$slot": "note",
            "$from": "live.groups[2].fields.note",
            "$example": "no deletion — routine remains inspectable via cap://legacy_etl for provenance; re-binding requires a live capability target"
          }
        }
      }
    ]
  }
}
