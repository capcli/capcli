{
  "$schema": "wireframe/v1",
  "id": "ws.peers.success.empty",
  "scenario": {
    "peers": "peers"
  },
  "target": {
    "$slot": "peers",
    "$from": "scenario.peers",
    "$example": "peers"
  },
  "command": {
    "$interpolate": "capcli ws {{peers}}",
    "$bindings": {
      "peers": "scenario.peers"
    },
    "$example": "capcli ws peers"
  },
  "elapsed_ms": {
    "$slot": "elapsed_ms",
    "$from": "live.elapsed_ms",
    "$type": "integer",
    "$example": 88
  },
  "context": {
    "env": "dev",
    "tier": "tier_1",
    "trust": "reviewed",
    "data_shape": {
      "$slot": "data_shape",
      "$from": "context.data_shape",
      "$example": "empty"
    }
  },
  "archetype": "receipt",
  "component": {
    "title": null,
    "groups": [
      {
        "fields": {
          "peers": {
            "$slot": "peers_2",
            "$from": "live.groups[0].fields.peers",
            "$example": "0 active"
          }
        }
      },
      {
        "lines": [
          {
            "$interpolate": "No federated {{peers}} registered. Register a peer before dialing ws:// targets.",
            "$bindings": {
              "peers": "scenario.peers"
            },
            "$example": "No federated peers registered. Register a peer before dialing ws:// targets."
          }
        ]
      }
    ]
  },
  "trailer": {
    "prompt": "doc://prompts/federation/outbound#1",
    "reason": {
      "$interpolate": "no active federated {{peers}} registered",
      "$bindings": {
        "peers": "scenario.peers"
      },
      "$example": "no active federated peers registered"
    },
    "serve": {
      "$slot": "serve",
      "$from": "live.trailer.serve",
      "$example": "L1"
    }
  }
}
