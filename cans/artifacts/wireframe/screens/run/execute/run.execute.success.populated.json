{
  "$schema": "wireframe/v1",
  "id": "run.execute.success.populated",
  "scenario": {
    "routine_urp": "cap://dispatch_order@4",
    "routine_name": "dispatch_order",
    "routine_version": 4,
    "order_id": "ORD-1042",
    "carrier": "fedex",
    "intent": "fulfill urgent pending orders"
