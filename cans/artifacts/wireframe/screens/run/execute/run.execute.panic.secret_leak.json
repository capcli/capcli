{
  "$schema": "wireframe/v1",
  "id": "run.execute.panic.secret_leak",
  "scenario": {
    "routine_urp": "cap://stripe.refund@2",
    "routine_name": "stripe.refund",
    "routine_version": 2,
    "charge_id": "ch_9d21K",
    "amount_cents": "1500",
    "intent": "refund failed delivery"
  },
  "target": {
    "$slot": "routine_urp",
    "$from": "scenario.routine_urp",
    "$example": "cap://stripe.refund@2"
  },
  "command": {
    "$interpolate": "capcli run {{routine_urp}} -p charge_id={{charge_id}} -p amount_cents={{amount_cents}} -m \"{{intent}}\"",
    "$bindings": {
      "routine_urp": "scenario.routine_urp",
      "amount_cents": "scenario.amount_cents",
      "charge_id": "scenario.charge_id",
      "intent": "scenario.intent"
    },
    "$example": "capcli run cap://stripe.refund@2 -p charge_id=ch_9d21K -p amount_cents=1500 -m \"refund failed delivery\""
  },
  "elapsed_ms": {
    "$slot": "elapsed_ms",
    "$from": "live.elapsed_ms",
    "$type": "integer",
    "$example": 128
  },
  "context": {
    "env": "dev",
    "tier": "tier_1",
    "trust": "reviewed"
  },
  "archetype": "diagnostic",
  "component": {
    "rule": "kernel.panic.secret_leak",
    "domain": "kernel.panic",
    "layer": "panic",
    "culprit": {
      "$slot": "culprit",
      "$from": "live.culprit",
      "$example": "Credential-shaped sequence matching active secret stripe_secret_key detected in routine stdout by kernel pattern scan; kill_and_alert executed."
    },
    "remedy": "strip the credential from the routine result, rotate stripe_secret_key via Cockpit vault, then re-prove in sim",
    "routine": {
      "$interpolate": "{{routine_name}}@{{routine_version}} ({{frame_id}})",
      "$bindings": {
        "routine_name": "scenario.routine_name",
        "routine_version": "scenario.routine_version",
        "frame_id": "live.frame_id"
      },
      "$example": "stripe.refund@2 (frame_029)"
    },
    "secret": {
      "$slot": "secret",
      "$from": "live.secret",
      "$example": "stripe_secret_key (sk_live_████████████████)"
    },
    "sink": {
      "$slot": "sink",
      "$from": "live.sink",
      "$example": "stdout — pattern scan matched secret-shaped bytes; vault zero-knowledge channel unaffected"
    },
    "kill_and_alert": {
      "$slot": "kill_and_alert",
      "$from": "live.kill_and_alert",
      "$example": "frame killed, session torn down,"
    },
    "lines": [
      {
        "$slot": "lines_0",
        "$from": "live.lines[0]",
        "$example": "credential-shaped sequence detected in routine output by kernel pattern scan"
      },
      {
        "$slot": "lines_1",
        "$from": "live.lines[1]",
        "$example": "human supervisor alerted via Cockpit push."
      }
    ]
  }
}
