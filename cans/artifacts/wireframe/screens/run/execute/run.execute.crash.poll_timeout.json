{
  "$schema": "wireframe/v1",
  "id": "run.execute.crash.poll_timeout",
  "scenario": {
    "routine_urp": "cap://media_digest@2",
    "routine_name": "media_digest",
    "routine_version": 2,
    "audience": "followers",
    "intent": "morning media digest"
  },
  "target": {
    "$slot": "routine_urp",
    "$from": "scenario.routine_urp",
    "$example": "cap://media_digest@2"
  },
  "command": {
    "$interpolate": "capcli run {{routine_urp}} -p audience={{audience}} -m \"{{intent}}\"",
    "$bindings": {
      "routine_urp": "scenario.routine_urp",
      "audience": "scenario.audience",
      "intent": "scenario.intent"
    },
    "$example": "capcli run cap://media_digest@2 -p audience=followers -m \"morning media digest\""
  },
  "elapsed_ms": {
    "$slot": "elapsed_ms",
    "$from": "live.elapsed_ms",
    "$type": "integer",
    "$example": 30000
  },
  "context": {
    "env": "dev",
    "tier": "tier_1",
    "trust": "draft"
  },
  "archetype": "diagnostic",
  "component": {
    "rule": "routine.runtime.timeout",
    "domain": "routine.runtime",
    "layer": "runtime",
    "culprit": {
      "$slot": "culprit",
      "$from": "live.culprit",
      "$example": "ctx.api.poll_until exceeded the 30-second in-flight ceiling while polling threads.create_media_post."
    },
    "measured": {
      "$slot": "measured",
      "$from": "live.measured",
      "$example": "poll duration 30.0s (ceiling 30s; requested 45s)"
    },
    "remedy": "set timeout_s to 30 or less, or restructure into a scheduled watch",
    "routine": {
      "$interpolate": "{{routine_name}}@{{routine_version}} ({{frame_id}})",
      "$bindings": {
        "routine_name": "scenario.routine_name",
        "routine_version": "scenario.routine_version",
        "frame_id": "live.frame_id"
      },
      "$example": "media_digest@2 (frame_028)"
    },
    "verb": {
      "$slot": "api_verb",
      "$from": "live.api_verb",
      "$example": "threads.create_media_post (container 1793881)"
    },
    "waited": {
      "$slot": "waited",
      "$from": "live.waited",
      "$example": "30.0s of requested timeout_s=45 (ceiling: 30s)"
    },
    "rollback": {
      "$slot": "rollback",
      "$from": "live.rollback",
      "$example": "clean (all ops reverted)"
    },
    "lines": [
      {
        "$slot": "lines_0",
        "$from": "live.lines[0]",
        "$example": "ctx.api.poll_until exceeded the 30-second in-flight ceiling;"
      },
      {
        "$slot": "lines_1",
        "$from": "live.lines[1]",
        "$example": "the watchdog killed the poll and reverted the frame."
      }
    ]
  }
}
