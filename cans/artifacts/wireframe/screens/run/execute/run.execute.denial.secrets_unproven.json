{
  "$schema": "wireframe/v1",
  "id": "run.execute.denial.secrets_unproven",
  "scenario": {
    "routine_urp": "cap://stripe.refund@2",
    "routine_name": "stripe.refund",
    "routine_version": 2,
    "charge_id": "ch_9d21K",
    "intent": "refund failed delivery"
  },
  "archetype": "diagnostic",
  "command": {
    "$interpolate": "capcli run {{routine_urp}} -p charge_id={{charge_id}} -m \"{{intent}}\"",
    "$bindings": {
      "routine_urp": "scenario.routine_urp",
      "charge_id": "scenario.charge_id",
      "intent": "scenario.intent"
    },
    "$example": "capcli run cap://stripe.refund@2 -p charge_id=ch_9d21K -m \"refund failed delivery\""
  },
  "component": {
    "culprit": {
      "$interpolate": "Draft routine {{routine_name}}@{{routine_version}} declares vault://stripe_secret_key; secret resolution requires the reviewed rung.",
      "$bindings": {
        "routine_name": "scenario.routine_name",
        "routine_version": "scenario.routine_version"
      },
      "$example": "Draft routine stripe.refund@2 declares vault://stripe_secret_key; secret resolution requires the reviewed rung."
    },
    "domain": "policy.trust",
    "layer": "trust",
    "lines": [
      {
        "$interpolate": "routine {{routine_name}}@{{routine_version}} holds draft trust",
        "$bindings": {
          "routine_name": "scenario.routine_name",
          "routine_version": "scenario.routine_version"
        },
        "$example": "routine stripe.refund@2 holds draft trust"
      },
      {
        "$slot": "lines_0",
        "$from": "live.lines[1]",
        "$example": "vault:// handles resolve only at trust >= reviewed"
      },
      {
        "$slot": "lines_1",
        "$from": "live.lines[2]",
        "$example": "denied at pre-flight (exit 2)"
      }
    ],
    "remedy": "prove in sim ('capcli routine prove stripe.refund --env sim'), then ship to reviewed",
    "rule": "policy.trust.secrets_unproven",
    "secret_ref": {
      "$slot": "secret_ref",
      "$from": "live.secret_ref",
      "$example": "vault://stripe_secret_key"
    }
  },
  "context": {
    "env": "dev",
    "tier": "tier_1",
    "trust": "draft"
  },
  "elapsed_ms": {
    "$slot": "elapsed_ms",
    "$from": "live.elapsed_ms",
    "$type": "integer",
    "$example": 41
  },
  "target": {
    "$slot": "routine_urp",
    "$from": "scenario.routine_urp",
    "$example": "cap://stripe.refund@2"
  }
}
