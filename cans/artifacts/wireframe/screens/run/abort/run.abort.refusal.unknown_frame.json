{
  "$schema": "wireframe/v1",
  "id": "run.abort.refusal.unknown_frame",
  "scenario": {
    "frame_id": "frame_999"
  },
  "archetype": "diagnostic",
  "command": {
    "$interpolate": "capcli run abort {{frame_id}}",
    "$bindings": {
      "frame_id": "scenario.frame_id"
    },
    "$example": "capcli run abort frame_999"
  },
  "elapsed_ms": {
    "$slot": "elapsed_ms",
    "$from": "live.elapsed_ms",
    "$type": "integer",
    "$example": 281
  },
  "component": {
    "culprit": {
      "$interpolate": "No suspended frame '{{{{frame_id}}}}' exists in _suspended_tasks.",
      "$bindings": {
        "frame_id": "live.frame_id"
      },
      "$example": "No suspended frame 'frame_999' exists in _suspended_tasks."
    },
    "domain": "missing_param",
    "frame": {
      "$slot": "frame_id_2",
      "$from": "scenario.frame_id",
      "$example": "frame_999"
    },
    "layer": "cli",
    "lines": [
      {
        "$interpolate": "capcli run abort {{{{frame_id}}}}",
        "$bindings": {
          "frame_id": "live.frame_id"
        },
        "$example": "capcli run abort frame_999"
      }
    ],
    "remedy": "inspect suspended frames via 'capcli run overview', then re-run with a listed frame id",
    "rule": "missing_param.unknown_frame"
  },
  "context": {
    "env": "dev",
    "tier": "tier_1",
    "trust": "pinned"
  },
  "target": {
    "$slot": "frame_id",
    "$from": "scenario.frame_id",
    "$example": "frame_999"
  }
}
