{
  "$schema": "wireframe/v1",
  "id": "run.inspect.success.ask",
  "scenario": {
    "ask_urp": "ask://ask_88a"
  },
  "target": {
    "$slot": "ask_urp",
    "$from": "scenario.ask_urp",
    "$example": "ask://ask_88a"
  },
  "command": {
    "$interpolate": "capcli inspect {{ask_urp}}",
    "$bindings": {
      "ask_urp": "scenario.ask_urp"
    },
    "$example": "capcli inspect ask://ask_88a"
  },
  "elapsed_ms": {
    "$slot": "elapsed_ms",
    "$from": "live.elapsed_ms",
    "$type": "integer",
    "$example": 63
  },
  "context": {
    "env": "dev",
    "tier": "tier_1",
    "trust": "pinned"
  },
  "archetype": "receipt",
  "component": {
    "title": null,
    "groups": [
      {
        "fields": {
          "target": {
            "$slot": "ask_urp_2",
            "$from": "scenario.ask_urp",
            "$example": "ask://ask_88a"
          },
          "question": {
            "$slot": "question",
            "$from": "live.groups[0].fields.question",
            "$example": "Flag transfer TXN-9918 as fraud?"
          },
          "options": {
            "$slot": "options",
            "$from": "live.groups[0].fields.options",
            "$example": "approve, deny, escalate"
          },
          "status": {
            "$slot": "status",
            "$from": "live.groups[0].fields.status",
            "$example": "pending"
          },
          "frame": {
            "$slot": "frame",
            "$from": "live.groups[0].fields.frame",
            "$example": "frame_026 (suspended, exits 6 until resolved)"
          }
        }
      },
      {
        "fields": {
          "preflight": {
            "$slot": "preflight",
            "$from": "live.groups[1].fields.preflight",
            "$example": "ask exists and is unresolved"
          },
          "can_invoke_now": {
            "$slot": "can_invoke_now",
            "$from": "live.groups[1].fields.can_invoke_now",
            "$example": "true"
          }
        }
      }
    ]
  }
}
