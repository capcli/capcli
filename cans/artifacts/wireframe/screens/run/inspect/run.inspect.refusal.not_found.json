{
  "$schema": "wireframe/v1",
  "id": "run.inspect.refusal.not_found",
  "scenario": {
    "pack_urp": "pack://routine/ghost_hook"
  },
  "target": {
    "$slot": "pack_urp",
    "$from": "scenario.pack_urp",
    "$example": "pack://routine/ghost_hook"
  },
  "command": {
    "$interpolate": "capcli inspect {{pack_urp}}",
    "$bindings": {
      "pack_urp": "scenario.pack_urp"
    },
    "$example": "capcli inspect pack://routine/ghost_hook"
  },
  "elapsed_ms": {
    "$slot": "elapsed_ms",
    "$from": "live.elapsed_ms",
    "$type": "integer",
    "$example": 118
  },
  "context": {
    "env": "dev",
    "tier": "tier_1",
    "trust": "draft"
  },
  "archetype": "diagnostic",
  "component": {
    "rule": "validation.pack.not_found",
    "domain": "validation",
    "culprit": {
      "$interpolate": "Pack URP '{{pack_urp}}' does not resolve to a registered blueprint.",
      "$bindings": {
        "pack_urp": "scenario.pack_urp"
      },
      "$example": "Pack URP 'pack://routine/ghost_hook' does not resolve to a registered blueprint."
    },
    "remedy": "run capcli search --type tpl and retry with an exact pack:// URP",
    "pack": {
      "$slot": "pack_urp_2",
      "$from": "scenario.pack_urp",
      "$example": "pack://routine/ghost_hook"
    },
    "registered": {
      "$slot": "registered",
      "$from": "live.registered",
      "$example": "4 packs (routine: 3, world: 1)"
    },
    "lines": [
      {
        "$slot": "lines_0",
        "$from": "live.lines[0]",
        "$example": "FATAL  validation.pack.not_found"
      },
      {
        "$slot": "lines_1",
        "$from": "live.lines[1]",
        "$example": "Pack URP does not resolve."
      }
    ]
  }
}
