          },
          {
            "$slot": "lines_1",
            "$from": "live.groups[2].lines[1]",
            "$example": "1. db.query    orders (read)"
          },
          {
            "$slot": "lines_2",
            "$from": "live.groups[2].lines[2]",
            "$example": "2. api.call    logistics.shipments.create"
          },
          {
            "$slot": "lines_3",
            "$from": "live.groups[2].lines[3]",
            "$example": "3. db.execute  orders (write)"
          }
        ]
      },
