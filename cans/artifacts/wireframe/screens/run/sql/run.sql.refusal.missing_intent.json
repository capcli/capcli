    },
    "layer": "missing_param",
    "lines": [
      {
        "$slot": "lines_0",
        "$from": "live.lines[0]",
        "$example": "FATAL  missing_param.no_intent"
      },
      {
        "$slot": "lines_1",
        "$from": "live.lines[1]",
        "$example": "UPDATE orders SET status = 'shipped' WHERE id = :id"
      }
    ]
  }
