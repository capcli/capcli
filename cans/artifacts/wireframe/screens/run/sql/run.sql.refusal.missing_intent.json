      "id": "scenario.id"
    },
    "$example": "capcli sql \"UPDATE orders SET status = 'shipped' WHERE id = :id\" -p id=4127"
  },
  "elapsed_ms": {
    "$slot": "elapsed_ms",
    "$from": "live.elapsed_ms",
    "$type": "integer",
    "$example": 169
  },
  "context": {
    "env": "dev",
    "tier": "tier_1",
    "trust": "draft"
  },
  "archetype": "diagnostic",
  "component": {
    "rule": "missing_param.no_intent",
    "domain": "missing_param",
    "culprit": {
      "$slot": "culprit",
      "$from": "live.culprit",
      "$example": "Mutating write rejected: -m/--intent is required for writes."
