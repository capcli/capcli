{
  "$schema": "wireframe/v1",
  "id": "bind.remove.refusal.not_found",
  "scenario": {
    "binding_id": "bnd_3k2f"
  },
  "target": {
    "$slot": "binding_id",
    "$from": "scenario.binding_id",
    "$example": "bnd_3k2f"
  },
  "command": {
    "$interpolate": "capcli bind remove {{binding_id}}",
    "$bindings": {
      "binding_id": "scenario.binding_id"
    },
    "$example": "capcli bind remove bnd_3k2f"
  },
  "elapsed_ms": {
    "$slot": "elapsed_ms",
    "$from": "live.elapsed_ms",
    "$type": "integer",
    "$example": 50
  },
  "context": {
    "env": "dev",
    "tier": "tier_1",
    "trust": "draft"
  },
  "archetype": "diagnostic",
  "component": {
    "rule": "validation.binding_not_found",
    "domain": "validation",
    "culprit": {
      "$slot": "culprit",
      "$from": "live.culprit",
      "$example": "Target binding ID not found. Trigger dismantle refused."
    },
    "remedy": "confirm the binding ID via capcli bind list",
    "binding_id": {
      "$slot": "binding_id_2",
      "$from": "scenario.binding_id",
      "$example": "bnd_3k2f"
    },
    "action": {
      "$slot": "action",
      "$from": "live.action",
      "$example": "remove"
    }
  }
}
