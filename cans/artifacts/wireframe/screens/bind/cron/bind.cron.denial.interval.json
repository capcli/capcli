{
  "$schema": "wireframe/v1",
  "id": "bind.cron.denial.interval",
  "scenario": {
    "routine_urp": "cap://sync_orders",
    "intent": "poll order queue every minute"
  },
  "target": {
    "$slot": "routine_urp",
    "$from": "scenario.routine_urp",
    "$example": "cap://sync_orders"
  },
  "command": {
    "$interpolate": "capcli bind cron poll_orders {{routine_urp}} \"* * * * *\" -m \"{{intent}}\"",
    "$bindings": {
      "routine_urp": "scenario.routine_urp",
      "intent": "scenario.intent"
    },
    "$example": "capcli bind cron poll_orders cap://sync_orders \"* * * * *\" -m \"poll order queue every minute\""
  },
  "elapsed_ms": {
    "$slot": "elapsed_ms",
    "$from": "live.elapsed_ms",
    "$type": "integer",
    "$example": 46
  },
  "context": {
    "env": "dev",
    "tier": "tier_1",
    "trust": "pinned"
  },
  "archetype": "diagnostic",
  "component": {
    "rule": "policy.authorizer.schedule_min_interval",
    "domain": "policy.authorizer",
    "layer": "authorizer",
    "culprit": {
      "$slot": "culprit",
      "$from": "live.culprit",
      "$example": "Interval lower than 5-minute cap. Sub-5-minute schedules refused."
    },
    "measured": {
      "$slot": "measured",
      "$from": "live.measured",
      "$example": "interval 1m (floor: 5m)"
    },
    "remedy": "raise the interval to 5 minutes or more; tighter reactivity belongs to inbound webhooks",
    "span": {
      "source": {
        "$slot": "source",
        "$from": "live.span.source",
        "$example": "FAIL  policy.authorizer.schedule_min_interval"
      },
      "highlight": {
        "$slot": "highlight",
        "$from": "live.span.highlight",
        "$example": "schedule_min_interval"
      }
    },
    "cron_expr": {
      "$slot": "cron_expr",
      "$from": "live.cron_expr",
      "$example": "* * * * *"
    }
  }
}
