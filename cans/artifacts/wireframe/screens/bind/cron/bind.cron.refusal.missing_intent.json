{
  "$schema": "wireframe/v2",
  "id": "bind.cron.refusal.missing_intent",
  "target": "cap://sync_orders",
  "command": "capcli bind cron nightly_sync cap://sync_orders \"0 3 * * *\"",
  "context": {
    "env": "dev",
    "tier": "tier_1",
    "trust": "draft"
  },
  "archetype": "diagnostic",
  "component": {
    "rule": "missing_param.intent_missing",
    "domain": "missing_param",
    "culprit": "Mutating bind requires an intent declaration. Unattributed triggers are refused.",
    "remedy": "re-run with -m \"why this trigger exists\"",
    "command": "capcli bind cron nightly_sync cap://sync_orders \"0 3 * * *\"",
    "flag": "-m / --intent"
  }
}
