{
  "$schema": "wireframe/v2",
  "id": "bind.webhook.success.bound",
  "target": "cap://sync_orders",
  "command": "capcli bind webhook stripe_hook stripe payment_succeeded cap://sync_orders --ingress https://ops.example.com/hook -m \"process fulfillment on stripe async payment success\"",
  "context": {
    "env": "dev",
    "tier": "tier_1",
    "trust": "pinned"
  },
  "audit_op": "op_2b9f",
  "archetype": "receipt",
  "component": {
    "title": null,
    "groups": [
      {
        "fields": {
          "binding_id": "bnd_8d3k",
          "name": "stripe_hook",
          "route": "https://ops.example.com/hook",
          "provider": "stripe",
          "event": "payment_succeeded",
          "target": "cap://sync_orders",
          "signing": "vault://stripe_webhook_secret (hmac-sha256)",
          "ingress": "verified (public https)"
        }
      },
      {
        "fields": {
          "state_modified": "true"
        }
      }
    ]
  }
}
